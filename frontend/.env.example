# Server-side only (used by BFF route handlers, never exposed to the browser)
API_BASE_URL=http://127.0.0.1:8121/api
API_CLIENT_ID=KOSAPI WEB:WEB
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/kos-bucket

# Exposed to the browser (Snap.js needs the Midtrans client key client-side)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_APP_NAME=Sewa Kos

# E2E only (npm run e2e; Playwright reads these from the shell, defaults shown). The backend under test needs
# OTP_DEBUG_ECHO=true, MIDTRANS_BASE_URL=http://<host>:E2E_MIDTRANS_PORT and MIDTRANS_SERVER_KEY=E2E_MIDTRANS_SERVER_KEY.
# It must run on a freshly seeded database (cmd/seed: owner 081200000001 and admin 081200000000), and TRUSTED_PROXIES
# must cover the peer it sees for host traffic so each Playwright visitor IP gets its own rate-limit quota.
E2E_API_URL=http://127.0.0.1:8121/api
E2E_MIDTRANS_SERVER_KEY=e2e-server-key
E2E_MIDTRANS_PORT=8125
