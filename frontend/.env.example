# Server-side only (used by BFF route handlers, never exposed to the browser)
API_BASE_URL=http://127.0.0.1:8121/api
API_CLIENT_ID=KOSAPI WEB:WEB
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/kos-bucket

# Exposed to the browser (Snap.js needs the Midtrans client key client-side)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_APP_NAME=Sewa Kos
