APP_ENV=development
HTTP_ADDR=:8121
DATABASE_URL=postgres://kos:kos@localhost:5432/kos?sslmode=disable
REDIS_URL=redis://localhost:6379/0
API_CLIENT_ID=KOSAPI WEB:WEB
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated IPs/CIDRs of the reverse proxy and Next.js server; X-Forwarded-For is ignored from any other peer.
TRUSTED_PROXIES=127.0.0.1,::1

OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_AFTER_SECONDS=60
OTP_MAX_PER_MINUTE=2
OTP_DEBUG_ECHO=true
# Cost caps on billable sends: per destination number per 24 hours, and per client IP per hour. 0 disables a cap.
OTP_MAX_PER_DAY=5
OTP_MAX_PER_IP_PER_HOUR=10
# WhatsApp codes: "log" = sandbox (codes only written to the log, nothing sent or billed), "fazpass" = real delivery.
# The older name OTP_PROVIDER is still read when OTP_WHATSAPP_PROVIDER is empty.
OTP_WHATSAPP_PROVIDER=log
# SMS codes: "off" = SMS hidden from users, "log" = sandbox, "smsgate" = real SMS sent from an Android phone.
OTP_SMS_PROVIDER=log
# Total SMS codes per day (WIB) across all users; protects the SIM balance and its standing with the carrier.
OTP_SMS_MAX_PER_DAY=50
# Fazpass merchant key (Bearer token) and the gateway key of the WhatsApp gateway, both from the Fazpass dashboard.
FAZPASS_BASE_URL=https://api.fazpass.com
FAZPASS_MERCHANT_KEY=
FAZPASS_GATEWAY_KEY=
# Cloud server credentials shown in the SMS gateway app on the phone (Settings > Cloud Server).
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Optional: pin one registered phone, and the SIM slot 1-3 (0 = the phone's default SIM).
SMSGATE_DEVICE_ID=
SMSGATE_SIM_NUMBER=0

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# "Signature Secret Key" from the Midtrans dashboard, used only to verify webhooks; empty = MIDTRANS_SERVER_KEY.
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_FINISH_URL=http://localhost:3000/booking
# Dev/E2E only: point Snap and status calls at a fake Midtrans. Refused when APP_ENV=production.
MIDTRANS_BASE_URL=

PAYMENT_EXPIRY_MINUTES=15
OWNER_RESPONSE_HOURS=24
OWNER_REMINDER_BEFORE_MINUTES=120

STORAGE_ENDPOINT=localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=kos-bucket
STORAGE_ACCESS_KEY=kosminio
STORAGE_SECRET_KEY=kosminio123
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/kos-bucket

UPLOAD_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=40000000
IMAGE_LARGE_PX=1600
IMAGE_THUMB_PX=400
IMAGE_LARGE_QUALITY=80
IMAGE_THUMB_QUALITY=75
IMAGE_MAX_CONCURRENCY=4

AREA_RADIUS_KM=3
RENEWAL_ISSUE_DAYS_BEFORE=3
RENEWAL_GRACE_DAYS=3

# Local sandbox: SMTP_HOST=localhost, SMTP_PORT=1025 (mailpit in docker-compose.yml, inbox at http://localhost:8025).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Sewa Kos <no-reply@sewakos.web.id>
APP_PUBLIC_URL=http://localhost:3000
