# install.sh writes deploy/.env with random secrets on the first run; this file only documents the keys.
# Public IP or domain the site is served on; storage is served on the same host at port 9000.
PUBLIC_HOST=203.0.113.10
# Let's Encrypt profile: "shortlived" is required when PUBLIC_HOST is an IP address, "classic" for a hostname.
ACME_PROFILE=shortlived
# www alias redirected to PUBLIC_HOST; "localhost" when PUBLIC_HOST is an IP address.
WWW_HOST=localhost
# Postgres owner, used only for migrations.
POSTGRES_PASSWORD=
# Password of the restricted kos_app role the API and worker connect as (set by install.sh after migrating).
APP_DB_PASSWORD=
# MinIO root credentials, also used by the API for uploads.
STORAGE_ACCESS_KEY=sewakos
STORAGE_SECRET_KEY=
# Shared secret the Next.js BFF sends in x-api-client.
API_CLIENT_ID=
# Midtrans keys from the dashboard; the web image must be rebuilt after changing the client key.
# Key prefixes do not tell sandbox from production: MIDTRANS_IS_PRODUCTION decides which Midtrans API is called.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# "Signature Secret Key" from the dashboard, used only to verify payment notifications; empty = MIDTRANS_SERVER_KEY.
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_IS_PRODUCTION=false
# SMTP relay (e.g. Brevo: smtp-relay.brevo.com, port 587, login xxxxx@smtp-brevo.com, password = SMTP key, not the API key).
# Empty SMTP_HOST, or a login without a password, keeps emails in the API log instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be a sender or domain verified at the SMTP provider.
EMAIL_FROM="Sewa Kos <no-reply@sewakos.web.id>"
