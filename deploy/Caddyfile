# Clients send no SNI when connecting to an IP address, so the certificate must be chosen by default_sni.
{
	default_sni {$PUBLIC_HOST}
}

# Let's Encrypt issues IP-address certificates only under "shortlived"; hostnames use "classic", whose shorter
# chain to ISRG Root X1 is accepted by older HTTP clients such as payment gateway webhooks.
(public_tls) {
	tls {
		issuer acme {
			profile {$ACME_PROFILE}
		}
	}
}

https://{$PUBLIC_HOST} {
	import public_tls
	encode zstd gzip
	handle /api/payments/midtrans/notification {
		reverse_proxy api:8121
	}
	handle {
		reverse_proxy web:3000
	}
}

# Presigned S3 URLs are signed for this exact host:port, so MinIO is served on its own port, not under a path.
https://{$PUBLIC_HOST}:9000 {
	import public_tls
	reverse_proxy minio:9000
}
